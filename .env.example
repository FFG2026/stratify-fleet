SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
APP_ORIGIN=http://localhost:3000
PORT=3000
DEMO_MODE=false

# Purchased domain: stratifyfleet.co.uk. Keep localhost for local development.
# Set APP_ORIGIN=https://stratifyfleet.co.uk only after HTTPS hosting is configured.

# Optional: DVLA Vehicle Enquiry Service key (free; apply to DVLA). Enables the "Look up" button on Add vehicle.
# Leave blank to turn the lookup off. Server-side only; never expose it in browser code.
DVLA_VES_API_KEY=
