# Same names as the current portal, so the same Vercel settings work. Server-side only: nothing here is exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional
DEMO_ACCOUNT_EMAIL=demo@stratifyfleet.co.uk
# Optional: DVLA Vehicle Enquiry Service key. Leave blank to turn the registration lookup off.
DVLA_VES_API_KEY=

# Optional, server-side only: lets administrators create logins with a temporary password. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public address of the portal, used in emailed links (password reset). Defaults to the address the request came to.
SITE_URL=
# Optional: set to true to require platform, insurer and customer administrators to use two-step sign-in. Leave off until each administrator has set theirs up.
REQUIRE_MFA_FOR_ADMINS=

# Optional: email delivery (Resend). Leave blank to keep the portal working without email. EMAIL_FROM must be an address on a domain verified with the provider.
RESEND_API_KEY=
EMAIL_FROM=
